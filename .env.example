# Telegram API Credentials (from https://my.telegram.org)
TG_API_ID=12345678
TG_API_HASH=your_telegram_api_hash_here

# Telegram Storage Channel ID (Private channel ID, usually starts with -100)
TG_CHANNEL_ID=-1001234567890

# MTProto Session Name (saved locally in data/ or root directory)
TG_SESSION_NAME=telegallery_session

# Local SQLite Database Path
DB_PATH=data/telegallery.db

# Storage & Upload Configuration
UPLOAD_CHUNK_SIZE_KB=512
MAX_CONCURRENT_UPLOADS=2
