@echo off
:: =============================================================================
:: Module: start.bat
:: Purpose: 1-Click Windows launcher script for Tellery (Gallery Vault).
:: Used by: Windows end-users.
:: Dependencies: python, run.py.
:: Side Effects: Launches Tellery and opens default browser.
:: =============================================================================
title Tellery (Gallery Vault)
echo Starting Tellery (Gallery Vault)...
python run.py
pause
